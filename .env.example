# Copie para .env e preencha antes do build.
# URL do checkout / página final para onde o botão "GARANTIR O MEU ESPAÇO AGORA" redireciona.
VITE_FINAL_CTA_URL=

# Taxa de câmbio EUR -> MZN usada nos exemplos de salário (opcional; sobrepõe o valor em src/config.ts).
VITE_EUR_TO_MZN_RATE=

# Endpoint opcional para receber o currículo (POST multipart/form-data, campo "cv").
# Se vazio, o ficheiro é apenas validado no navegador e não é enviado para nenhum servidor.
VITE_CV_UPLOAD_ENDPOINT=
